{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/skills.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eyebrow",
    "heading",
    "intro",
    "filterLabel",
    "detailMeta",
    "logoAlt",
    "families",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "intro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hover",
        "touch"
      ],
      "properties": {
        "hover": {
          "type": "string",
          "minLength": 1,
          "description": "Shown on devices with a pointer."
        },
        "touch": {
          "type": "string",
          "minLength": 1,
          "description": "Shown on touch screens."
        }
      }
    },
    "filterLabel": {
      "type": "string",
      "minLength": 1
    },
    "detailMeta": {
      "type": "string",
      "minLength": 1,
      "description": "Uses {family} and {number}."
    },
    "logoAlt": {
      "type": "string",
      "minLength": 1,
      "description": "Uses {name}."
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "name",
          "family",
          "text"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "description": "Element-style symbol, unique."
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "description": "A family id."
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "logo": {
            "type": "string",
            "minLength": 1,
            "description": "Name of an SVG in public/logos, without .svg. Optional."
          }
        }
      }
    }
  }
}
