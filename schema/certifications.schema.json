{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/certifications.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eyebrow",
    "heading",
    "intro",
    "verify",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Screen-reader text. Uses {title}."
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer",
          "title",
          "meta"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "kind": {
            "enum": [
              "degree"
            ],
            "description": "Marks a degree, which is left out of the credentials sent to search engines."
          }
        }
      }
    }
  }
}
