{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/services.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eyebrow",
    "heading",
    "intro",
    "items",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text",
          "points"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind",
              "section"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "section"
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind",
              "link"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "link"
              },
              "link": {
                "type": "string",
                "minLength": 1
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "resume"
              },
              "primary": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "kind",
              "message"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "whatsapp"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "description": "Text placed in the visitor's WhatsApp message box."
              },
              "primary": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    }
  }
}
