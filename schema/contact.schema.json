{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "content/contact.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eyebrow",
    "heading",
    "intro",
    "rows",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "heading": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "muted": {
            "type": "boolean"
          }
        }
      },
      "description": "One entry per word; words animate in separately."
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "description": "Text. May use {name}, {email}, {location}, {github}, {linkedin}; *grey phrase*; __gradient__; [label](url)."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label",
              "send",
              "copy",
              "subject"
            ],
            "properties": {
              "kind": {
                "const": "email"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "send": {
                "type": "string",
                "minLength": 1
              },
              "copy": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label",
              "action"
            ],
            "properties": {
              "kind": {
                "const": "whatsapp"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "link",
              "label",
              "action"
            ],
            "properties": {
              "kind": {
                "const": "link"
              },
              "link": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label",
              "action"
            ],
            "properties": {
              "kind": {
                "const": "resume"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copied",
        "selected",
        "preparing",
        "saved",
        "saveFailed"
      ],
      "properties": {
        "copied": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "string",
          "minLength": 1
        },
        "preparing": {
          "type": "string",
          "minLength": 1
        },
        "saved": {
          "type": "string",
          "minLength": 1
        },
        "saveFailed": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
