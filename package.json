{
  "name": "gajendrasinh-zala-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site for Gajendrasinh Zala. Content lives in content/*.json and is rendered to static HTML at build time.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "validate": "node scripts/validate-content.mjs",
    "build": "node scripts/build.mjs",
    "build:embed": "node scripts/build.mjs --embed",
    "preview": "node scripts/dev.mjs --no-watch",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0"
  }
}
